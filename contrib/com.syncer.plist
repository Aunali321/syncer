<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.syncer</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Change this if cargo installs elsewhere. -->
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "$HOME/.cargo/bin/syncer" run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/syncer.log</string>
</dict>
</plist>
